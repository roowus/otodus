{
  "base": "dark",
  "tokens": {
    "--background": "#0a0f14",
    "--editor-surface": "#070b0f",
    "--foreground": "#dde6ee",
    "--card": "#111821",
    "--card-foreground": "#dde6ee",
    "--popover": "#151d27",
    "--popover-foreground": "#dde6ee",
    "--primary": "#4aa3d8",
    "--primary-foreground": "#04121c",
    "--secondary": "#182331",
    "--secondary-foreground": "#dde6ee",
    "--muted": "#141e29",
    "--muted-foreground": "#8fa3b5",
    "--accent": "#1b2836",
    "--accent-foreground": "#eaf2f8",
    "--border": "#22303f",
    "--input": "#22303f",
    "--ring": "#4aa3d8",
    "--sidebar": "#0d141b",
    "--sidebar-foreground": "#cfdae4",
    "--sidebar-primary": "#4aa3d8",
    "--sidebar-primary-foreground": "#04121c",
    "--sidebar-accent": "#182533",
    "--sidebar-accent-foreground": "#eaf2f8",
    "--sidebar-border": "#1d2937",
    "--sidebar-ring": "#4aa3d8",
    "--worktree-sidebar": "#0d141b",
    "--worktree-sidebar-foreground": "#cfdae4",
    "--worktree-sidebar-accent": "#182533",
    "--worktree-sidebar-accent-foreground": "#eaf2f8",
    "--worktree-sidebar-border": "#1d2937",
    "--worktree-sidebar-ring": "#4aa3d8",
    "--worktree-sidebar-active": "#16222f",
    "--worktree-sidebar-active-border": "#4aa3d8",
    "--tab-bar": "#0c1218",
    "--tab-active": "#111821",
    "--tab-active-foreground": "#eaf2f8",
    "--tab-active-indicator": "#4aa3d8",
    "--tab-inactive": "#0c1218",
    "--tab-inactive-foreground": "#8fa3b5",
    "--split-divider": "#1b2836",
    "--split-divider-hover": "#2b3d4f",
    "--host-badge": "#16324a",
    "--host-badge-foreground": "#a8d6f2",
    "--chat-user-message": "#16222f",
    "--chat-muted-foreground": "#8fa3b5",
    "--chat-inline-code": "#1b2836",
    "--chat-inline-code-foreground": "#a8d6f2",
    "--chat-code-block": "#0b1117",
    "--chat-selection": "#1e3b52",
    "--chat-selection-foreground": "#eaf2f8",
    "--text-link": "#6cb8e6",
    "--editor-selection": "#1e3b52",
    "--diff-added": "#3fb58a",
    "--diff-added-background": "#0f2a22",
    "--diff-removed": "#e0645c",
    "--diff-removed-background": "#2a1415",
    "--git-decoration-added": "#4dbf92",
    "--git-decoration-modified": "#e0a94a",
    "--git-decoration-deleted": "#e0645c",
    "--git-decoration-renamed": "#6cb8e6",
    "--git-decoration-untracked": "#4dbf92",
    "--chart-1": "#4aa3d8",
    "--chart-2": "#6cb8e6",
    "--chart-3": "#3d8fbf",
    "--chart-4": "#8fd0e8",
    "--chart-5": "#2f7aa6"
  },
  "tokenColors": [
    { "name": "Comment", "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#5f7a8f", "fontStyle": "italic" } },
    { "name": "Keyword", "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "#6cb8e6" } },
    { "name": "String", "scope": ["string", "constant.other.symbol"], "settings": { "foreground": "#8fd0a8" } },
    { "name": "Number, constant", "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#e0a94a" } },
    { "name": "Function", "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#a8d6f2" } },
    { "name": "Type, class", "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#7fd1c8" } },
    { "name": "Variable", "scope": ["variable", "variable.other"], "settings": { "foreground": "#dde6ee" } },
    { "name": "Property", "scope": ["variable.other.property", "meta.object-literal.key"], "settings": { "foreground": "#b9d6ea" } },
    { "name": "Tag", "scope": ["entity.name.tag"], "settings": { "foreground": "#6cb8e6" } },
    { "name": "Invalid", "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#e0645c" } }
  ]
}
